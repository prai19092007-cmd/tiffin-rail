# Copy this file to .env and fill in your own values

# --- Option A: local MySQL, individual fields ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=tiffin_rail

# --- Option B: single connection string (hosted MySQL providers) ---
# If DATABASE_URL is set, it is used instead of the DB_* fields above.
# DATABASE_URL=mysql://user:password@host:3306/tiffin_rail

# Set to "true" for hosted MySQL that requires an encrypted (SSL/TLS) connection.
# Leave as "false" for a local MySQL server.
DB_SSL=false

SESSION_SECRET=change-this-to-a-long-random-string
PORT=3000

# --- Your private platform admin login ---
# This is the ONLY account with access to /admin. Never shown anywhere on the
# site — set it here, then run `node db/seed.js` to apply it.
ADMIN_EMAIL=your-real-email@example.com
ADMIN_PASSWORD=choose-a-strong-password
