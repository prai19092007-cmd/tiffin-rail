<%- include('partials/header') %>

<h1>My favorites</h1>

<% if (kitchens.length === 0) { %>
  <div class="empty-block">
    <span class="empty-icon">♡</span>
    <p class="empty-title">No favorites yet</p>
    <p class="empty-sub"><a href="/">Browse kitchens</a> and tap the heart to save one.</p>
  </div>
<% } else { %>
  <section class="grid">
    <% kitchens.forEach(k => { %>
      <div class="card kitchen-card">
        <form action="/favorite/<%= k.kitchen_id %>/toggle" method="POST" class="fav-form">
          <button type="submit" class="fav-btn fav-active" title="Remove from favorites">♥</button>
        </form>
        <a href="/kitchen-detail/<%= k.kitchen_id %>" class="card-link">
          <div class="card-image" role="img" aria-label="Photo of <%= k.name %>" <% if (k.image_url) { %>style="background-image:url('<%= k.image_url %>')"<% } %>>
            <% if (!k.image_url) { %><span class="card-image-fallback">🍱</span><% } %>
          </div>
          <div class="card-body">
            <div class="card-top">
              <h3><%= k.name %></h3>
              <span class="rating">&#9733; <%= k.rating %></span>
            </div>
            <div class="badge-row">
              <span class="food-badge food-<%= k.food_type.toLowerCase().replace('-', '') %>"><%= k.food_type %></span>
            </div>
            <p class="cuisine"><%= k.cuisine_type %></p>
            <p class="location"><%= k.location %></p>
            <span class="badge-subs"><%= k.active_subscribers %> active subscriber<%= k.active_subscribers == 1 ? '' : 's' %></span>
          </div>
        </a>
      </div>
    <% }) %>
  </section>
<% } %>

<%- include('partials/footer') %>
