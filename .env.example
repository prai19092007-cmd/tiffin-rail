# Copy this file to .env and fill in your own values

# --- Option A: single connection string (used by Render/Supabase/Railway) ---
# Leave this commented out for local setup — uncomment and fill in only when deploying.
# DATABASE_URL=postgresql://user:password@host:5432/tiffin_trail

# --- Option B: local Postgres, individual fields (used if DATABASE_URL is not set) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tiffin_trail

# Set to "false" only for local Postgres without SSL
PGSSL=false

SESSION_SECRET=change-this-to-a-long-random-string
PORT=3000

# --- Your private platform admin login ---
# This is the ONLY account with access to /admin. Never shown anywhere on the
# site — set it here, then run `node db/seed.js` to apply it.
ADMIN_EMAIL=your-real-email@example.com
ADMIN_PASSWORD=choose-a-strong-password
