<%- include('partials/header') %>

<h1>My subscriptions</h1>
<% if (subscribed) { %>
  <p class="success-banner">Subscribed successfully! Subscription #<%= subscribed %></p>
<% } %>

<% var expiringSoon = subs.filter(s => s.status === 'Active' && s.days_left <= 3 && s.days_left >= 0); %>
<% if (expiringSoon.length > 0) { %>
  <div class="reminder-banner">
    &#9203; <%= expiringSoon.length %> subscription<%= expiringSoon.length > 1 ? 's are' : ' is' %> ending soon &mdash; renew below to avoid a gap in your tiffin.
  </div>
<% } %>

<% if (subs.length === 0) { %>
  <div class="empty-block">
    <span class="empty-icon">🍱</span>
    <p class="empty-title">No subscriptions yet</p>
    <p class="empty-sub"><a href="/">Browse kitchens</a> to get started.</p>
  </div>
<% } else { %>
  <section class="order-list">
    <% subs.forEach(s => { %>
      <div class="order-row sub-row">
        <div>
          <h4><%= s.kitchen_name %> &middot; <%= s.plan_name %></h4>
          <p class="muted"><%= new Date(s.start_date).toLocaleDateString() %> &rarr; <%= new Date(s.end_date).toLocaleDateString() %></p>
          <% if (s.status === 'Active' && s.days_left <= 3 && s.days_left >= 0) { %>
            <span class="expiry-tag"><%= s.days_left == 0 ? 'Ends today' : 'Ends in ' + s.days_left + ' day' + (s.days_left > 1 ? 's' : '') %></span>
          <% } %>
        </div>
        <div class="order-meta">
          <span class="status status-<%= s.status.toLowerCase() %>"><%= s.status %></span>
          <strong>&#8377;<%= s.price %></strong>
        </div>
        <% if (s.status === 'Active' || s.status === 'Paused') { %>
          <div class="sub-actions">
            <% if (s.status === 'Active') { %>
              <form action="/subscription/<%= s.subscription_id %>/pause" method="POST" class="pause-form">
                <input type="number" name="days" min="1" max="14" value="3" title="Days to pause" />
                <input type="text" name="reason" placeholder="Reason (optional)" />
                <button type="submit" class="link-btn">Pause</button>
              </form>
            <% } else { %>
              <form action="/subscription/<%= s.subscription_id %>/resume" method="POST" class="inline-form">
                <button type="submit" class="link-btn">Resume now</button>
              </form>
            <% } %>
            <form action="/subscription/<%= s.subscription_id %>/cancel" method="POST" class="inline-form">
              <button type="submit" class="link-btn danger">Cancel</button>
            </form>
          </div>
        <% } %>
      </div>
    <% }) %>
  </section>
<% } %>

<%- include('partials/footer') %>
